# Copy to .env for local testing. On Railway, add these under your service → Variables.

# REQUIRED — from @BotFather (/mybots → MiniSEOToolsBot → API Token)
TELEGRAM_BOT_TOKEN=123456789:replace-me

# Optional access control (comma-separated Telegram user IDs; get yours from @userinfobot)
ALLOWED_USER_IDS=
ADMIN_USER_IDS=
COOLDOWN_SECONDS=3

# Optional, free: raises PageSpeed Insights quota
PAGESPEED_API_KEY=

# Google Autocomplete market for /suggest and /questions
SUGGEST_HL=en
SUGGEST_GL=us

# Paid data (SEMrush-style volumes, backlinks, traffic, SERPs) — https://dataforseo.com
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# 2840 = United States, 2566 = Nigeria, 2826 = United Kingdom, 2124 = Canada, 2356 = India
DATAFORSEO_LOCATION_CODE=2840
DATAFORSEO_LANGUAGE_CODE=en

# Cheaper alternative for /serp, /rank and /track only — https://serper.dev
SERPER_API_KEY=
SERPER_GL=us
SERPER_HL=en

# Rank tracking
MAX_TRACKED_PER_CHAT=20
TRACK_HOUR_UTC=6
# DATA_DIR defaults to /data when a Railway Volume is mounted there
DATA_DIR=
